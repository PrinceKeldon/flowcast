DATABASE_URL="postgresql://user:password@localhost:5432/kilig?schema=public"

# Lightweight single-password admin gate for the mutations in lib/actions.ts
# (createTitle, addAvailability, addReaction) and /admin. Leave unset to
# keep admin routes fully closed. See lib/admin.ts.
ADMIN_PASSWORD=""

# Set once the domain is registered — used for sitemap.xml and
# robots.txt's sitemap reference. Both degrade gracefully (empty
# sitemap, no sitemap line in robots.txt) if this is left unset, so
# it's safe to deploy without it and add later.
NEXT_PUBLIC_SITE_URL=""
